{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://passeidireito.app/schemas/questao.schema.json",
  "title": "PasseiDireito – unidade de trilha",
  "description": "Um arquivo = uma unidade da trilha de uma materia, com suas questoes de multipla escolha. O simulado sorteia questoes de todos os arquivos.",
  "type": "object",
  "required": ["versaoFormato", "materia", "unidade", "questoes"],
  "additionalProperties": false,
  "properties": {
    "versaoFormato": {
      "description": "Versao deste formato. Permite ao app ler arquivos antigos sem quebrar.",
      "type": "integer",
      "const": 1
    },
    "materia": {
      "description": "Codigo da materia. Civil so cai na discursiva, mas tem trilha propria.",
      "type": "string",
      "enum": ["adm", "const", "trib", "pc", "urb", "trab", "prev", "pen", "emp", "civ"]
    },
    "unidade": {
      "type": "object",
      "required": ["id", "titulo", "itemEdital"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identificador imutavel da unidade. Nunca reutilizar nem renumerar.",
          "type": "string",
          "pattern": "^[a-z]+-[0-9]{2}$"
        },
        "titulo": { "type": "string", "minLength": 3, "maxLength": 80 },
        "itemEdital": {
          "description": "Numero do item da materia no Anexo II do Edital 6/2026. E o que permite medir a cobertura do edital.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "questoes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/questao" }
    }
  },
  "definitions": {
    "letra": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
    "cincoTextos": {
      "description": "Um texto para cada letra, A a E, nem mais nem menos: a prova da FAFIPA tem cinco alternativas.",
      "type": "object",
      "required": ["A", "B", "C", "D", "E"],
      "additionalProperties": false,
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 },
        "C": { "type": "string", "minLength": 1 },
        "D": { "type": "string", "minLength": 1 },
        "E": { "type": "string", "minLength": 1 }
      }
    },
    "questao": {
      "type": "object",
      "required": ["id", "tema", "enunciado", "alternativas", "correta", "dica", "explicacao", "fontes", "origem"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identificador imutavel: codigo da materia + numero. Nunca reutilizar: o progresso da aluna aponta para ele.",
          "type": "string",
          "pattern": "^[a-z]+-[0-9]{4}$"
        },
        "tema": { "type": "string", "minLength": 3, "maxLength": 100 },
        "enunciado": { "type": "string", "minLength": 20 },
        "alternativas": { "$ref": "#/definitions/cincoTextos" },
        "correta": { "$ref": "#/definitions/letra" },
        "dica": {
          "description": "Orienta sem entregar. O validador recusa dica que cite a letra da resposta.",
          "type": "string",
          "minLength": 20
        },
        "explicacao": {
          "description": "Por que a correta esta correta e por que CADA errada esta errada. As cinco sao obrigatorias.",
          "$ref": "#/definitions/cincoTextos"
        },
        "fontes": {
          "description": "Dispositivo, sumula ou precedente que sustenta o gabarito, com a data. Nada posterior a data de corte entra.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tipo", "referencia", "data"],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "type": "string",
                "enum": ["constituicao", "lei", "decreto", "sumula", "sumula-vinculante", "repercussao-geral", "repetitivo", "controle-concentrado", "tce-pr", "outro"]
              },
              "referencia": { "type": "string", "minLength": 5 },
              "data": {
                "description": "Data da norma, da sumula ou da tese (AAAA-MM-DD).",
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "origem": {
          "type": "object",
          "required": ["tipo"],
          "additionalProperties": false,
          "properties": {
            "tipo": { "type": "string", "enum": ["inedita", "adaptada"] },
            "prova": {
              "description": "Prova de onde a questao foi adaptada, quando for o caso. Ex.: NC-UFPR 2019, PGM Curitiba.",
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    }
  }
}
