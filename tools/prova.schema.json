{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://passeidireito.app/schemas/prova.schema.json",
  "title": "PasseiDireito – prova real anterior",
  "description": "Um arquivo = uma prova real da FAFIPA ja aplicada, reproduzida na ordem e numeracao originais. Separado do banco de trilha (tools/questao.schema.json): aqui entra tambem o que nao bate com o Anexo II de Curitiba, porque o objetivo e reproduzir a prova historica, nao ensinar o edital atual.",
  "type": "object",
  "required": [
    "versaoFormato",
    "prova",
    "questoes"
  ],
  "additionalProperties": false,
  "properties": {
    "versaoFormato": {
      "description": "Versao deste formato. Permite ao app ler arquivos antigos sem quebrar.",
      "type": "integer",
      "const": 1
    },
    "prova": {
      "type": "object",
      "required": [
        "id",
        "concurso",
        "banca",
        "ano",
        "cargo",
        "dataAplicacao",
        "gabaritoDefinitivoPublicado",
        "fonte"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identificador imutavel do arquivo e das questoes dele. Nunca reutilizar nem renumerar.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "concurso": {
          "description": "Ex.: 'PGM Matinhos/PR', 'Camara de Cambara-PR'.",
          "type": "string",
          "minLength": 3
        },
        "banca": {
          "type": "string",
          "const": "FAFIPA"
        },
        "ano": {
          "type": "integer",
          "minimum": 2000
        },
        "cargo": {
          "type": "string",
          "minLength": 3
        },
        "dataAplicacao": {
          "description": "Data em que a prova foi aplicada (AAAA-MM-DD). E a data de corte desta prova: fonte posterior a ela nao vale para explicar o gabarito, mesmo que seja anterior a 21/09/2026.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "gabaritoDefinitivoPublicado": {
          "type": "boolean"
        },
        "fonte": {
          "description": "Link do caderno oficial ou do site onde ele foi obtido.",
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "questoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/questaoDeProva"
      }
    }
  },
  "definitions": {
    "letra": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "cincoTextos": {
      "type": "object",
      "required": ["A", "B", "C", "D", "E"],
      "additionalProperties": false,
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 },
        "C": { "type": "string", "minLength": 1 },
        "D": { "type": "string", "minLength": 1 },
        "E": { "type": "string", "minLength": 1 }
      }
    },
    "questaoDeProva": {
      "type": "object",
      "required": [
        "numeroOriginal",
        "id",
        "materia",
        "tema",
        "enunciado",
        "alternativas",
        "correta",
        "dica",
        "explicacao",
        "fontes"
      ],
      "additionalProperties": false,
      "properties": {
        "numeroOriginal": {
          "description": "Numero da questao no caderno oficial. Define a ordem de exibicao.",
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "description": "Identificador imutavel: id da prova + numero sequencial proprio (nao precisa bater com numeroOriginal, porque questoes nao-juridicas sao puladas).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-[0-9]{3}$"
        },
        "materia": {
          "description": "Nossa classificacao da questao, para poder cruzar com as estatisticas do banco principal.",
          "type": "string",
          "enum": ["adm", "const", "trib", "pc", "urb", "trab", "prev", "pen", "emp", "civ"]
        },
        "tema": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "enunciado": {
          "type": "string",
          "minLength": 20
        },
        "alternativas": {
          "$ref": "#/definitions/cincoTextos"
        },
        "correta": {
          "$ref": "#/definitions/letra"
        },
        "dica": {
          "description": "Orienta sem entregar. O validador recusa dica que cite a letra da resposta.",
          "type": "string",
          "minLength": 20
        },
        "explicacao": {
          "description": "Por que a correta esta correta e por que CADA errada esta errada.",
          "$ref": "#/definitions/cincoTextos"
        },
        "fontes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tipo", "referencia", "data"],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "constituicao", "lei", "decreto", "sumula", "sumula-vinculante",
                  "repercussao-geral", "repetitivo", "controle-concentrado", "tce-pr", "outro"
                ]
              },
              "referencia": { "type": "string", "minLength": 5 },
              "data": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            }
          }
        }
      }
    }
  }
}
